      };

      // --- Sidebar Component ---[cite: 4]
      const Sidebar = ({ currentTab, onSelectTab, onOpenNewReservation, pendingReservationsCount, mobileOpen, onCloseMobile }) => {
        const navItems = [
          { id: 'dashboard', label: 'Dashboard', materialIcon: 'dashboard' },
          { id: 'menu', label: 'Menu CMS', materialIcon: 'restaurant_menu' },
          { id: 'reservations', label: 'Reservations', materialIcon: 'event_available', badge: pendingReservationsCount > 0 ? pendingReservationsCount : undefined },
          { id: 'bento_media', label: 'Bento & Media', materialIcon: 'grid_view' },
          { id: 'analytics', label: 'Analytics', materialIcon: 'monitoring' },
          { id: 'reports', label: 'Reports & Logs', materialIcon: 'receipt_long' },
          { id: 'settings', label: 'Settings', materialIcon: 'settings' }
        ];

        return (
          <React.Fragment>
            {mobileOpen && (
              <div 
                className="fixed inset-0 bg-[#1A1A1A]/40 z-40 md:hidden backdrop-blur-xs"
                onClick={onCloseMobile}
              />
            )}
            <aside className={`
