<!Doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Totot Kitfo & Adulis Luxury - Artistic Portfolio & Admin</title>
    <meta name="description" content="Artistic Flair dining management and culinary portfolio for Totot Kitfo." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,600;1,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <!-- React & Babel CDKs for single-file runtime -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
      :root {
        --paper-bg: #FDFCF5;
        --paper-card: #FFFFFF;
        --paper-muted: #F5F3EB;
        --paper-secondary: #EFECE5;
        --charcoal: #1A1A1A;
        --charcoal-light: #2A2A2A;
        --text-muted: rgba(26, 26, 26, 0.6);
        --text-subtle: rgba(26, 26, 26, 0.4);
        --border-artistic: rgba(26, 26, 26, 0.1);
        --border-artistic-strong: rgba(26, 26, 26, 0.2);
        --primary: #1A1A1A;
        --primary-container: #EFECE5;
        --on-surface: #1A1A1A;
        --on-surface-variant: rgba(26, 26, 26, 0.7);
      }

      body {
        background-color: #FDFCF5;
        color: #1A1A1A;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }

      h1, h2, h3, h4, .font-serif-title, .font-serif {
        font-family: 'Playfair Display', 'Source Serif 4', Georgia, serif;
      }

      .font-sans {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }

      .bento-card {
        background-color: #FFFFFF;
        border: 1px solid rgba(26, 26, 26, 0.1);
        border-radius: 0.5rem;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 1px 3px rgba(26, 26, 26, 0.03);
      }

      .bento-card:hover {
        border-color: rgba(26, 26, 26, 0.25);
        box-shadow: 0 10px 30px -10px rgba(26, 26, 26, 0.08);
      }

      .bento-input {
        background-color: #FFFFFF;
        border: 1px solid rgba(26, 26, 26, 0.15);
        color: #1A1A1A;
        transition: all 0.2s ease;
      }

      .bento-input:focus {
        border-color: #1A1A1A;
        outline: none;
        box-shadow: 0 0 0 1px #1A1A1A;
      }

      .table-row-divider {
        border-bottom: 1px solid rgba(26, 26, 26, 0.08);
      }

      .table-row-divider:last-child {
        border-bottom: none;
      }

      /* Custom Scrollbars */
      ::-webkit-scrollbar {
        width: 5px;
        height: 5px;
      }
      ::-webkit-scrollbar-track {
        background: transparent;
      }
      ::-webkit-scrollbar-thumb {
        background-color: rgba(26, 26, 26, 0.15);
        border-radius: 9999px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background-color: rgba(26, 26, 26, 0.35);
      }

      /* Material Symbols alignment */
      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        vertical-align: middle;
      }
      .material-symbols-outlined.fill-1 {
        font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      }

      /* Artistic Flair specific helper classes */
      .artistic-stamp {
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.35em;
        text-transform: uppercase;
        color: rgba(26, 26, 26, 0.45);
      }

      .artistic-badge {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        padding: 3px 8px;
        border-radius: 9999px;
        border: 1px solid rgba(26, 26, 26, 0.15);
        background-color: #EFECE5;
        color: #1A1A1A;
      }
    </style>
  </head>
  <body class="bg-[#FDFCF5] text-[#1A1A1A] antialiased selection:bg-[#1A1A1A] selection:text-[#FDFCF5]">
    <div id="root"></div>

